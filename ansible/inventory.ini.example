; Generated from `terraform output` after a successful `terraform apply`.
; Copy to inventory.ini and fill in the real IPs - inventory.ini itself is
; gitignored because EC2 public IPs change every time the VLE-4 instances
; are recreated.
[servers]
server1 ansible_host=REPLACE_WITH_INSTANCE_1_PUBLIC_IP
server2 ansible_host=REPLACE_WITH_INSTANCE_2_PUBLIC_IP

[servers:vars]
ansible_user=ec2-user
ansible_ssh_private_key_file=~/.ssh/labsuser.pem
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
